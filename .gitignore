# 도구·빌드 산출물
.venv/
build/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/
node_modules/
screen/dist/
.claude/
# 내려받은 자료와 만든 번들 (크다. 받는 곳은 docs/REFERENCE_BingoTime.md §1.2)
자료/
data/raw/
data/bundles/
*.zip
# 예외: 실행할 때 풀어 쓰는 번들 묶음. 저장소에 함께 올린다 (scripts/make_release.py가 만들고 host/fetch.py가 푼다)
!release/*.zip
# 현장 화면에서 찍은 사진 (기기에 두는 것. 사람이 찍힐 수 있다)
photos_live/
# React Bits에서 받은 참고 코드 가운데 화면에서 쓰지 않는 것. 그 라이선스(MIT + Commons Clause)는 컴포넌트만 따로 다시 나눠 주는 것을
# 막으므로 올리지 않는다. 화면에서 실제로 쓰는 것만 screen/src/vendor/ 에 둔다
screen/vendor_reference/
# 개인 작업 흔적
.backup_*/
docs.zip
.DS_Store
reports/

